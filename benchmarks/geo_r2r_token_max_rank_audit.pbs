#!/bin/bash
#PBS -N geo_r2r_rank_audit
#PBS -l filesystems=home:eagle
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=02:00:00
#PBS -q by-gpu
#PBS -A datascience_collab
#PBS -r y

set -euo pipefail
cd /home/nhogg/vllm-ce
export LD_PRELOAD=/soft/libraries/nccl/nccl_2.30.4-1+cuda13.2_x86_64/lib/libnccl.so
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false HF_HUB_OFFLINE=1
export VLLM_USE_V2_MODEL_RUNNER=1 VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_USE_FLASHINFER_SAMPLER=0
export PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/r2r-v2-audit-pycache"

OUTPUT_ROOT="${GEO_OUTPUT_ROOT:-results/r2r_v2/rank_audit}"
mkdir -p "${OUTPUT_ROOT}"

.venv/bin/python benchmarks/benchmark_kv_eviction_ablation_vllm.py \
  --single --regime prefill_only --frac "${GEO_PREFILL_FRAC:-0.8}" \
  --model "${GEO_MODEL:-/eagle/datascience_collab/nhogg/Llama-3.2-3B-Instruct}" \
  --tasks "${GEO_TASK:-multifieldqa_en}" \
  --num-prompts "${GEO_NUM_PROMPTS:-10}" \
  --max-prompt-len "${GEO_MAX_PROMPT_LEN:-4096}" \
  --max-model-len "${GEO_MAX_MODEL_LEN:-8192}" \
  --gpu-mem-util "${GEO_GPU_MEM_UTIL:-0.9}" \
  --score-sampled-layers "${GEO_LAYERS:-3,10,17,24}" \
  --warmup-pages 1 --candidate-expansion-factor 4 \
  --r2r-cover-depth 2 --r2r-query-aggregation max \
  --r2r-persistent-floor --r2r-dispersion-kappa 2.0 \
  --r2r-relevance-signal key_anchor --r2r-token-max-audit \
  --dump-json "${OUTPUT_ROOT}/audit.json"
